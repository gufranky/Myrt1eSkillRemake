<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Myrt1eSkill_Remake</RootNamespace>
    <AssemblyName>Myrt1eSkill_Remake</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
    <PackageReference Include="ValveResourceFormat" Version="19.2.6339" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RayTraceApi">
      <HintPath>libs\RayTraceApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="gamedata\Myrt1eSkill_Remake.gamedata.json"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="gamedata\Myrt1eSkill_Remake.gamedata.json" />
  </ItemGroup>

  <!-- ValveResourceFormat also supports rendering and exporting, but this plugin
       only uses its NAV/VPK readers. Copy the small runtime subset instead of
       shipping hundreds of megabytes of unrelated native rendering assets. -->
  <Target Name="CopyNavMeshRuntimeAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_NavMeshRuntimeAssembly Include="@(ReferencePath)"
          Condition="'%(ReferencePath.Filename)' == 'ValveResourceFormat'
                  Or '%(ReferencePath.Filename)' == 'ValvePak'
                  Or '%(ReferencePath.Filename)' == 'ValveKeyValue'
                  Or '%(ReferencePath.Filename)' == 'K4os.Compression.LZ4'
                  Or '%(ReferencePath.Filename)' == 'ZstdSharp'
                  Or '%(ReferencePath.Filename)' == 'System.IO.Hashing'" />
    </ItemGroup>
    <Copy SourceFiles="@(_NavMeshRuntimeAssembly)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
